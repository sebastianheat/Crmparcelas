# ─── Base de datos (Postgres) ───────────────────────────────────────────────
# Runtime de la app: usa un rol restringido (NO superusuario) para que las
# políticas Row-Level Security se apliquen. Ver scripts/setup-roles.sql.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/5000"
# Migraciones y seed: rol owner con permisos de DDL.
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/5000"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-en-produccion"
AUTH_TRUST_HOST="true"

# ─── IA (Anthropic / Claude) ────────────────────────────────────────────────
# Requisito de producto: toda la generación de texto usa la API de Anthropic.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── Facturación electrónica (DTE) ──────────────────────────────────────────
# Proveedor: mock | openfactura | libredte | simpleapi
DTE_PROVIDER="mock"
DTE_API_KEY=""

# ─── Conciliación bancaria (open banking) ───────────────────────────────────
# Proveedor: mock | fintoc
BANK_PROVIDER="mock"
FINTOC_SECRET_KEY=""
FINTOC_LINK_TOKEN=""
FINTOC_ACCOUNT_ID=""

# ─── Firma electrónica ──────────────────────────────────────────────────────
# Proveedor: mock | firmavirtual (Clave Única, Ley 19.799)
SIGNATURE_PROVIDER="mock"

# ─── WhatsApp (agente IA) ───────────────────────────────────────────────────
# Proveedor: mock | cloud (Meta Cloud API) | 360dialog
WHATSAPP_PROVIDER="mock"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="5000-verify"
# Tenant por defecto para mensajes entrantes (mientras no haya mapeo por número)
WHATSAPP_DEFAULT_TENANT=""

# ─── Almacenamiento de archivos ─────────────────────────────────────────────
# Si defines BLOB_READ_WRITE_TOKEN (Vercel Blob) se usa Blob; si no, Postgres.
BLOB_READ_WRITE_TOKEN=""
