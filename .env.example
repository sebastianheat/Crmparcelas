# ─── Base de datos (Postgres) ───────────────────────────────────────────────
# Runtime de la app: usa un rol restringido (NO superusuario) para que las
# políticas Row-Level Security se apliquen. Ver scripts/setup-roles.sql.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/5000"
# Migraciones y seed: rol owner con permisos de DDL.
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/5000"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-en-produccion"
AUTH_TRUST_HOST="true"

# ─── IA (Anthropic / Claude) ────────────────────────────────────────────────
# Requisito de producto: toda la generación de texto usa la API de Anthropic.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── Facturación electrónica (DTE) ──────────────────────────────────────────
# Proveedor: mock | bsale | openfactura | libredte | simpleapi
DTE_PROVIDER="mock"
DTE_API_KEY=""
# Bsale (DTE_PROVIDER=bsale):
BSALE_TOKEN=""           # access_token de Bsale
BSALE_DOC_TYPE_ID=""     # id del tipo "factura exenta" en tu cuenta
BSALE_OFFICE_ID=""       # id de la sucursal emisora
BSALE_PRICE_LIST_ID=""   # (opcional) id de lista de precios
# BSALE_API_BASE="https://api.bsale.io/v1"

# ─── Conciliación + cobros (Fintoc, open banking + payment intents) ──────────
# Proveedor de banco: mock | fintoc
BANK_PROVIDER="mock"
FINTOC_SECRET_KEY=""        # sk_live_… / sk_test_…
FINTOC_PUBLIC_KEY=""        # pk_live_… (widget de pago, lado cliente)
FINTOC_LINK_TOKEN=""        # token del link de la cuenta conectada
FINTOC_ACCOUNT_ID=""        # cuenta a conciliar
FINTOC_WEBHOOK_SECRET=""    # secreto del webhook (firma Fintoc-Signature)
# FINTOC_API_BASE="https://api.fintoc.com/v1"  # override opcional

# ─── Firma electrónica ──────────────────────────────────────────────────────
# Proveedor: mock | firmavirtual (Clave Única, Ley 19.799)
SIGNATURE_PROVIDER="mock"

# ─── Recordatorios (Vercel Cron) ────────────────────────────────────────────
# Secreto para proteger /api/cron/reminders (Vercel lo envía como Bearer).
CRON_SECRET=""

# ─── WhatsApp (agente IA) ───────────────────────────────────────────────────
# Proveedor: mock | cloud (Meta Cloud API) | 360dialog
WHATSAPP_PROVIDER="mock"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="5000-verify"
# Tenant por defecto para mensajes entrantes (mientras no haya mapeo por número)
WHATSAPP_DEFAULT_TENANT=""

# ─── Almacenamiento de archivos ─────────────────────────────────────────────
# Si defines BLOB_READ_WRITE_TOKEN (Vercel Blob) se usa Blob; si no, Postgres.
BLOB_READ_WRITE_TOKEN=""
